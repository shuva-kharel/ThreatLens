# =============================================================================
# MiniSOC ThreatLens — Root .gitignore
# =============================================================================
# One .gitignore for the entire monorepo (backend + frontend).
# =============================================================================


# =============================================================================
# 🔐 SECRETS & ENVIRONMENT (CRITICAL — NEVER COMMIT)
# =============================================================================

# Environment files
.env
*.env

# Secrets and credentials
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/
credentials.json
service-account.json

# API keys (backup catch-all)
*api_key*
*apikey*
!*api_key*.py
!*api_key*.ts
!*api_key*.md


# =============================================================================
# 🐍 PYTHON (Backend)
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

