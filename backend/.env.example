# ===== API Configuration =====
API_KEY=your-static-api-key-here
SECRET_KEY=your-secret-key

# ===== Database =====
DATABASE_URL=sqlite:///./minisoc.db

# ===== Automated Response Orchestration =====
# Disabled until explicitly enabled; automatic actions default to dry-run.
AUTOMATIC_RESPONSE_ENABLED=false
AUTOMATIC_RESPONSE_DRY_RUN=true
RESPONSE_PIPELINE_VERSION=v1
# demo records simulated enforcement; real dispatches to an authenticated lab agent.
RESPONSE_EXECUTION_MODE=demo

# ===== Endpoint Agents =====
# Replace with a long random value in .env. Never expose this to the frontend.
AGENT_SHARED_SECRET=replace-with-a-long-random-lab-secret
AGENT_OFFLINE_SECONDS=30
AGENT_TASK_TIMEOUT_SECONDS=15
# Comma-separated addresses agents must never block. Add backend, management,
# gateway and DNS addresses used by your lab.
PROTECTED_ADDRESSES=127.0.0.1,::1

# ===== Demo Lab =====
# JSON array of controlled VMware assets. Addresses must be private.
DEMO_LAB_ASSETS=[{"id":"WIN-TARGET-01","hostname":"WIN-TARGET-01","ip":"192.168.56.20","os":"Windows"},{"id":"LINUX-TARGET-01","hostname":"LINUX-TARGET-01","ip":"192.168.56.21","os":"Linux"}]
DEMO_LAB_MAX_DURATION_SECONDS=60
DEMO_LAB_MAX_EVENTS=30
DEMO_LAB_MAX_CONCURRENT_RUNS=1

# ===== Human Escalation Notifications =====
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
FRONTEND_BASE_URL=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== AI Providers (Primary, Fallback, Fallback2) =====
# AI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ===== Groq (Primary - FASTEST) =====
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ===== Google Gemini (Fallback - Smart) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ===== OpenRouter (Fallback 2 - Many models) =====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
